<Project>
  <!-- Intentionally does NOT import the parent Directory.Build.props (that one configures MSVC for the C++ build). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Version of the native rocksdb NuGet package (rocksdb-sharp) used as the reference implementation in tests/benchmarks. -->
    <NativeRocksDbPackageVersion>11.12.0.7385</NativeRocksDbPackageVersion>
  </PropertyGroup>

  <!-- NuGet metadata for the packages built from src/ (.azure-devops/nuget-rocksdb-managed.yml); the pipeline sets Version. -->
  <PropertyGroup>
    <Authors>Curiosity GmbH</Authors>
    <Company>Curiosity GmbH</Company>
    <!-- Same dual license as upstream RocksDB (LICENSE.Apache / COPYING in the repository root). -->
    <PackageLicenseExpression>Apache-2.0 OR GPL-2.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/curiosity-ai/rocksdb/tree/main/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/curiosity-ai/rocksdb</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>rocksdb;key-value;storage;database;lsm;embedded</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
