<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RocksDb.Managed.Replication</RootNamespace>
    <AssemblyName>RocksDb.Managed.Replication</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Replication (checkpoint + WAL streaming), planned switchover and a Raft cluster layer for RocksDb.Managed. Transport-agnostic.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RocksDb.Managed\RocksDb.Managed.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Internal async primitive shared with the engine (allocation-free broadcast wake-ups for commit / sequence waits). -->
    <Compile Include="..\RocksDb.Managed\Util\AsyncBroadcastSignal.cs" Link="Internal\AsyncBroadcastSignal.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RocksDb.Managed.Replication.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
