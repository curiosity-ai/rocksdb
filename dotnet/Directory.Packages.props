<Project>
  <ItemGroup>
    <!-- Library -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- Optional gRPC hosting of the replication layer (same versions as rocksdb-sharp's Tests/ReplicationTest etc.). -->
    <PackageVersion Include="MagicOnion.Server" Version="7.10.0" />
    <PackageVersion Include="MagicOnion.Client" Version="7.10.0" />
    <!-- Pinned above MagicOnion's transitive 3.1.4, which has published advisories (NU1902). -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- Tests / benchmarks -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Allocation tracing (GCAllocationTick + call stacks) for tools/RocksDb.Managed.AllocationProfile. -->
    <PackageVersion Include="Memory.Introspect" Version="26.10.7230" />
    <!-- Reference native implementation (rocksdb-sharp + native librocksdb). -->
    <PackageVersion Include="RocksDB" Version="$(NativeRocksDbPackageVersion)" />
  </ItemGroup>
</Project>
