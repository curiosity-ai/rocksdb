<Project>
  <ItemGroup>
    <!-- Library -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- Tests / benchmarks -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Reference native implementation (rocksdb-sharp + native librocksdb). -->
    <PackageVersion Include="RocksDB" Version="$(NativeRocksDbPackageVersion)" />
  </ItemGroup>
</Project>
